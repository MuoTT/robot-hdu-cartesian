# Execute an ordered list of absolute waypoints.
#
# Each waypoint is one straight-line move. Z encodes the pen state: the
# caller inserts z_up / z_down points itself. The server waits for a PLC
# ACK after every point and stops on the first failure.
#
# The PLC has no per-point motion profile. Set velocity/acceleration/
# deceleration/jerk globally through robonix/primitive/plotter/set_params
# before calling this contract.
#
# Units: mm.
plotter/Waypoint[] waypoints
---
bool    success
string  message
# Number of requested waypoints accepted for execution.
uint32  points_accepted
# Number of requested waypoints that completed before returning.
uint32  points_completed
float64 elapsed_s